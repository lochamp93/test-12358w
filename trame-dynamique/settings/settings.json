				{
					"value": "jeu",
					"label": "Artwork du jeu (dynamique)"
				},
				{
					"value": "musique",
					"label": "Musique en cours (dynamique)"
				},
				{
					"value": "chaine",
					"label": "Photo de profil de la chaîne (fixe)"
				},
				{
					"value": "perso",
					"label": "Couleurs personnalisées (fixe)"
				}
			],
			"defaultValue": "jeu",
			"group": "Source des couleurs"
		},
		{
			"id": "channel",
			"label": "Chaîne Twitch",
			"description": "Laisser vide pour utiliser la chaîne connectée à Streamer.bot",
