{
	"title": "Subgoal",
	"design": "apple",
	"showLogo": false,
	"showNuttyLink": false,
	"checkerPreview": true,
	"settings": [
		{
			"id": "address",
			"label": "Adresse Streamer.bot",
			"type": "text",
			"defaultValue": "127.0.0.1",
			"group": "Streamer.bot"
		},
		{
			"id": "port",
			"label": "Port Streamer.bot",
			"type": "number",
			"min": 1,
			"max": 65535,
			"defaultValue": 8080,
			"group": "Streamer.bot"
		},
		{
			"id": "decapiUsername",
			"label": "Chaîne Twitch",
			"description": "<a href=\"https://decapi.me/auth/twitch?redirect=subcount&scopes=channel:read:subscriptions+user:read:email+moderator:read:followers+user:read:email\" target=\"_blank\">Cliquer et Autoriser",
			"type": "text",
			"defaultValue": "",
			"group": "Objectif",
			"placeholder": "Pseudo de la chaîne"
		},
		{
			"id": "subGoalLabel",
			"label": "Titre",
			"type": "text",
			"defaultValue": "",
			"group": "Objectif",
			"placeholder": "Ex. : Objectif du mois"
		},
		{
			"id": "subGoal",
			"label": "Objectif d’abonnements",
			"type": "number",
			"min": 1,
			"defaultValue": 420,
			"group": "Objectif"
		},
		{
			"id": "showLastSub",
			"label": "Dernier abonné",
			"description": "Affiche « DERNIER SUB : pseudo » à côté de la barre de progression.",
			"type": "checkbox",
			"defaultValue": true,
			"group": "Objectif"
		},
		{
			"id": "font",
			"label": "Police",
			"description": "Police installée ou Google Fonts. <a href=\"ms-settings:fonts\">voir les polices</a>",
			"type": "font",
			"defaultValue": "",
			"group": "Style"
		},
		{
			"id": "subTitleColor",
			"label": "Couleur du titre",
			"type": "color",
			"defaultValue": "#B3B3B3",
			"group": "Style"
		},
		{
			"id": "subCurrentColor",
			"label": "Couleur du nombre d’abonnés",
			"type": "color",
			"defaultValue": "#FFFFFF",
			"group": "Style"
		},
		{
			"id": "subSeparatorColor",
			"label": "Couleur du séparateur",
			"type": "color",
			"defaultValue": "#8C8C8C",
			"group": "Style"
		},
		{
			"id": "subGoalColor",
			"label": "Couleur de l’objectif",
			"type": "color",
			"defaultValue": "#B3B3B3",
			"group": "Style"
		},
		{
			"id": "fontbgColor",
			"label": "Couleur du fond de la barre",
			"type": "color",
			"defaultValue": "#000000",
			"group": "Style"
		},
		{
			"id": "decorLineColor",
			"label": "Couleur de la ligne déco",
			"description": "Couleur de la ligne à droite (utile si fond clair).",
			"type": "color",
			"defaultValue": "#FFFFFF",
			"group": "Style"
		},
		{
			"id": "decorLineOpacity",
			"label": "Opacité de la ligne déco",
			"description": "De 0 à 1",
			"type": "number",
			"min": 0,
			"max": 1,
			"step": "0.05",
			"defaultValue": 1,
			"group": "Style"
		},
		{
			"id": "chatCommand",
			"label": "Commande",
			"description": "Paramètres : on, off, {durée}<br>Exemples : !vibemeter on, !vibemeter off, !vibemeter 5",
			"type": "text",
			"defaultValue": "!vibemeter",
			"group": "Vibemeter"
		},
		{
			"id": "permissionLevel",
			"label": "Permission",
			"description": "Ces utilisateurs peuvent démarrer/arrêter le Vibe Meter",
			"type": "select",
			"options": [
				{
					"value": 40,
					"label": "Streamer"
				},
				{
					"value": 30,
					"label": "Mods & Streamer"
				},
				{
					"value": 20,
					"label": "VIP, Mods & Streamer"
				},
				{
					"value": 15,
					"label": "Abonnés, VIP, Mods & Streamer"
				},
				{
					"value": 10,
					"label": "Tout le monde"
				},
				{
					"value": 69420,
					"label": "Personne"
				}
			],
			"defaultValue": 30,
			"group": "Vibemeter"
		},
		{
			"id": "testVibeMeter",
			"label": "Tester le vibemeter",
			"description": "Vibe de 8 secondes avec de fausses notes, rien n’est envoyé dans le chat",
			"type": "actions",
			"buttons": [
				{
					"icon": "play",
					"style": "accent",
					"title": "Tester le vibemeter",
					"callFunction": "TestVibeMeter"
				}
			],
			"group": "Vibemeter"
		},
